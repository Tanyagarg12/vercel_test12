# Base URL of the AI Asset Intelligence Platform API.
#
# Copy this file to `.env.local` and set the current URL, then restart the dev
# server. The dashboard header shows "Live API" when it is reading the service
# and "Demo data" when it falls back to the local synthetic dataset — so live
# figures are never confused with synthetic ones.
#
# Leave unset to run entirely on demo data.
#
# Server-side only: deliberately NOT prefixed with NEXT_PUBLIC_, so the address
# (and any credential added later) never ships to the browser.
API_BASE_URL=https://asset-intelligence-platform-production.up.railway.app
