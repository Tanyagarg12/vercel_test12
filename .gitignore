# ---- Python (backend) ----
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# ---- Node / Next.js (frontend) ----
node_modules/
.next/
out/
build/
dist/
coverage/
next-env.d.ts
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Browser automation / test artefacts ----
# Playwright is installed ad hoc for screenshot checks and is not an app
# dependency, so nothing it produces belongs in the repo.
playwright-report/
playwright/.cache/
test-results/
chromium_cli/
*.png.tmp

# ---- Local databases & data dumps ----
# The demo dataset is generated from a seeded generator, never committed.
*.db
*.sqlite
*.sqlite3

# ---- Secrets / environment ----
.env
.env.*
!.env.example
*.pem

# ---- Logs & debug output ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pip-log.txt
*.pid
*.seed

# ---- Caches ----
.eslintcache
.turbo/
.cache/
.parcel-cache/
.swc/

# ---- Scratch / temporary working files ----
# Ad-hoc probe scripts and screenshots written while debugging must never be
# committed — an unset output path once produced a literal `undefined/` folder.
tmp/
temp/
scratch/
undefined/
*.bak
*.orig
*.rej
*.local

# ---- Editors & tooling ----
.vscode/
.idea/
*.swp
*.swo
*.tsbuildinfo

# ---- AI coding assistant config (local to each developer) ----
# AGENTS.md is regenerated by `next dev`, so it is left on disk but untracked
# rather than churning the diff on every run.
CLAUDE.md
AGENTS.md
.claude/
.cursor/
.aider*
.github/copilot-instructions.md
.continue/
.windsurfrules
.sourcegraph/

# ---- Office lock & recovery files ----
# Word writes a hidden `~$name.docx` beside any open document and leaves it
# behind if it crashes. The requirements doc and the pitch deck both live in
# this repo, so these would otherwise appear as untracked files.
~$*
*.tmp
*.wbk
*.asd

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Deploy platforms ----
.vercel
